#!/usr/bin/env bash
# 크로스 컴파일한 실행 파일을 Jetson에 복사한다. 실행 중인 프로그램은 건드리지 않는다.
set -euo pipefail

usage() {
    cat <<EOF
usage: jetson-deploy USER@HOST REMOTE_DIR [프로젝트 폴더]

  USER@HOST      Jetson 접속 정보
  REMOTE_DIR     Jetson에서 실행 파일을 둘 절대 경로
  프로젝트 폴더  기본값은 현재 폴더

  복사 대상: <프로젝트>/build/jetson/install/bin/*
EOF
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[ $# -ge 2 ] && [ $# -le 3 ] || { usage; exit 2; }

host="$1"
remote_dir="$2"
project="${3:-.}"

bin_dir="$project/build/jetson/install/bin"
shopt -s nullglob
binaries=("$bin_dir"/*)
if [ ${#binaries[@]} -eq 0 ]; then
    echo "복사할 파일이 없습니다. 먼저 jetson-build를 실행하세요: $bin_dir" >&2
    exit 1
fi

export MSYS_NO_PATHCONV=1
ssh "$host" "mkdir -p '$remote_dir'"
scp "${binaries[@]}" "$host:$remote_dir/"
ssh "$host" "echo \"arch: \$(uname -m)\"; ls -l '$remote_dir'"
