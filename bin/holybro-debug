#!/usr/bin/env bash
# Jetson에서 실행 중인 프로그램을 PC에서 gdb로 디버깅한다.
# SSH 한 번으로 Jetson에 gdbserver를 띄우고 그 포트를 PC로 가져온 뒤,
# 컨테이너의 gdb-multiarch가 Jetson sysroot와 PC의 디버그 빌드로 접속한다.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/common.sh"

usage() {
    cat <<EOF
usage: holybro-debug [-p PORT] [-l LOCAL_PORT] USER@HOST REMOTE_PROGRAM [-- 인자...]

  -p PORT          SSH 포트 (기본 22)
  -l LOCAL_PORT    PC 쪽 gdb 포트 (기본 2345)
  USER@HOST        Jetson 접속 정보
  REMOTE_PROGRAM   Jetson의 실행 파일 절대 경로 (holybro-deploy로 복사한 것)
  -- 인자...       프로그램에 넘길 인자

  현재 폴더(프로젝트)의 build/jetson/install/bin/<같은 이름>을 디버그 정보로 쓴다.
  먼저 holybro-build --debug 후 holybro-deploy로 같은 파일을 Jetson에 복사해 둔다.
  gdb를 끝내면(quit) Jetson의 프로그램과 gdbserver도 끝난다.

  환경 변수 JETSON_GDB_ARGS: gdb에 추가로 넘길 인자 (예: "-batch -ex 'break main' -ex run")
EOF
}

port=22
local_port=2345
positional=()
program_args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -p) [ $# -ge 2 ] || { usage; exit 2; }; port="$2"; shift ;;
        -l) [ $# -ge 2 ] || { usage; exit 2; }; local_port="$2"; shift ;;
        --) shift; program_args=("$@"); break ;;
        -*) usage; exit 2 ;;
        *) positional+=("$1") ;;
    esac
    shift
done
[ ${#positional[@]} -eq 2 ] || { usage; exit 2; }
host="${positional[0]}"
remote_program="${positional[1]}"
name="$(basename "$remote_program")"

project="$(pwd)"
root="$(find_project_root "$project")"
relative="$(relative_path "$root" "$project")"
local_binary="build/jetson/install/bin/$name"
if [ ! -f "$project/$local_binary" ]; then
    echo "디버그 정보로 쓸 파일이 없습니다: $project/$local_binary" >&2
    echo "holybro-build --debug 후 holybro-deploy로 Jetson에 복사하세요." >&2
    exit 1
fi
if ! file -b "$project/$local_binary" | grep -q "with debug_info"; then
    echo "경고: $local_binary 에 디버그 정보가 없습니다. holybro-build --debug로 다시 빌드하세요." >&2
fi
require_docker

# Jetson의 gdbserver는 Jetson 안(127.0.0.1)에서만 열고, SSH로 PC의 local_port에 연결한다.
remote_port=2345
quoted_args=""
for a in ${program_args[@]+"${program_args[@]}"}; do quoted_args+=" $(printf '%q' "$a")"; done
# gdbserver 메시지(stderr)는 화면에 보여 주면서 파일에도 남겨, 열렸는지 그 메시지로 판단한다.
# 포트에 접속해서 확인하면 gdbserver --once가 그 접속을 디버거로 받아 끝나 버린다.
log="$(mktemp)"
ssh -p "$port" -o BatchMode=yes -o ExitOnForwardFailure=yes \
    -L "127.0.0.1:$local_port:127.0.0.1:$remote_port" "$host" \
    "command -v gdbserver >/dev/null || { echo 'Jetson에 gdbserver가 없습니다: sudo apt install gdbserver' >&2; exit 1; }
     exec gdbserver --once 127.0.0.1:$remote_port $(printf '%q' "$remote_program")$quoted_args" \
    2> >(tee "$log" >&2) &
ssh_pid=$!
trap 'kill "$ssh_pid" 2>/dev/null || true; rm -f "$log"' EXIT

# gdbserver가 열릴 때까지 기다린다(최대 15초)
for _ in $(seq 1 30); do
    grep -q "Listening on port" "$log" && break
    if ! kill -0 "$ssh_pid" 2>/dev/null; then
        echo "Jetson에서 gdbserver를 시작하지 못했습니다." >&2
        exit 1
    fi
    sleep 0.5
done
grep -q "Listening on port" "$log" || { echo "gdbserver가 15초 안에 열리지 않았습니다." >&2; exit 1; }

# 컨테이너에서 PC의 local_port로: WSL·Linux의 Docker 엔진은 호스트 네트워크를 같이 쓰고,
# Windows의 Docker Desktop(Git Bash)은 host.docker.internal이 PC를 가리킨다.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) gdb_host=host.docker.internal ;;
    *) gdb_host=127.0.0.1; export JETSON_DOCKER_ARGS="--network host ${JETSON_DOCKER_ARGS:-}" ;;
esac

gdb_args=()
[ -n "${JETSON_GDB_ARGS:-}" ] && eval "gdb_args=($JETSON_GDB_ARGS)"
run_in_container "$root" "$relative" gdb-multiarch -q \
    -ex "set sysroot /opt/jetson/sysroot" \
    -ex "set solib-search-path /opt/jetson/sysroot/usr/lib/aarch64-linux-gnu" \
    -ex "file $local_binary" \
    -ex "target remote $gdb_host:$local_port" \
    ${gdb_args[@]+"${gdb_args[@]}"}
